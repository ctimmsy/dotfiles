{{- $hostname := lower .chezmoi.hostname -}}
{{- $desktop := eq $hostname "og_tower" -}}
{{- $laptop := eq $hostname "archmac" -}}

-- CONVERTED FROM hyprlang (hyprland.conf) TO THE NEW LUA CONFIG FORMAT (Hyprland 0.55+)
-- Refer to the wiki for more information: https://wiki.hypr.land/Configuring/Start/
--
-- A couple of spots are marked "VERIFY" below -- these are dispatcher/field names I'm
-- less than 100% certain about since the Lua API is very new (docs are still filling in).
-- Everything else follows the official example config / wiki 1:1.
-- #######################################################################################
 
-- Remove this to remove the autogenerated warning banner
-- hl.config({ autogenerated = true })
 
------------------
---- MONITORS ----
------------------
 
-- See https://wiki.hypr.land/Configuring/Basics/Monitors/
{{- if $desktop }}
hl.monitor({ output = "", mode = "preferred", position = "auto", scale = 1 })
{{- end }}

{{- if $laptop }}
-- Setting intel card as default (saves on power)
hl.env("AQ_DRM_DEVICES", "/dev/dri/intel-igpu:/dev/dri/amd-igpu")

hl.monitor({ output = "eDP-2", disabled = true })
hl.monitor({ output = "eDP-1", mode = "preferred", position = "auto", scale = 1.5 })
{{- end }} 

---------------------
---- MY PROGRAMS ----
---------------------
 
local terminal    = "ghostty"
local fileManager = "dolphin"
local menu        = "rofi -show drun"
 
-------------------
---- AUTOSTART ----
-------------------
 
-- See https://wiki.hypr.land/Configuring/Basics/Autostart/
hl.on("hyprland.start", function()
    hl.exec_cmd("waybar")
    hl.exec_cmd("hyprpaper")

{{- if $desktop }}
    hl.exec_cmd("/usr/lib/hyprpolkitagent/hyprpolkitagent")
    hl.exec_cmd("bash -c 'pgrep -x hypridle >/dev/null || hypridle'")
    hl.exec_cmd("zen", { workspace = "1 silent" })
    hl.exec_cmd("obsidian", { workspace = "special:magic silent" })
{{- end }}

{{- if $laptop }}
    hl.exec_cmd("hypridle")
    hl.exec_cmd("zen-browser", { workspace = "1 silent" })
    hl.exec_cmd(
        "obsidian --enable-features=UseOzonePlatform --ozone-platform=wayland",
        { workspace = "special:magic silent" }
    )
{{- end }}

    hl.exec_cmd(terminal, { workspace = "2 silent" })
end) 

-------------------------------
---- ENVIRONMENT VARIABLES ----
-------------------------------

hl.env("XCURSOR_SIZE", "24")
hl.env("HYPRCURSOR_SIZE", "24")

{{- if $desktop }}
hl.env("SSH_AUTH_SOCK", "$XDG_RUNTIME_DIR/ssh-agent.socket")
{{- end }}

